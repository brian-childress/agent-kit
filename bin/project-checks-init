#!/usr/bin/env bash
# project-checks-init — opt a repo into the shared deterministic checks (run explicitly; never automatic).
# Copies <kit>/templates/project files (lefthook.yml, .agent/*) that don't already exist, creates a local,
# git-ignored .agent-policy.json in the main checkout, then installs lefthook git hooks.
# Usage: project-checks-init [--no-hooks] [DIR=repo root]
set -u
. "$(dirname "$(readlink -f "$0")")/_lib.sh"
hooks=1; target=.
for a in "$@"; do case "$a" in --no-hooks) hooks=0;; -h|--help) sed -n '2,5p' "$0"; exit 0;; *) target="$a";; esac; done
root=$(repo_root "$target"); tpl="$KIT_HOME/templates/project"
(cd "$tpl" && find . -type f ! -name .agent-policy.json) | while read -r rel; do
  dest="$root/${rel#./}"
  if [ -e "$dest" ]; then echo "keep   ${rel#./} (exists)"; else mkdir -p "$(dirname "$dest")"; cp "$tpl/$rel" "$dest"; echo "added  ${rel#./}"; fi
done
# .agent-policy.json is local dev setup, never committed: it lives in the main checkout, is ignored through the
# shared .git/info/exclude, and every linked worktree inherits it (agent-policy falls back to the main checkout).
common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
if [ -n "$common" ]; then
  main=$(dirname "$common"); [ "$(basename "$common")" = .git ] || main="$root"
  if [ -e "$main/.agent-policy.json" ]; then echo "keep   .agent-policy.json (exists in $main)"
  else cp "$tpl/.agent-policy.json" "$main/.agent-policy.json"; echo "added  .agent-policy.json in $main (local only)"; fi
  mkdir -p "$common/info"
  grep -qxF "/.agent-policy.json" "$common/info/exclude" 2>/dev/null || { echo "/.agent-policy.json" >> "$common/info/exclude"; echo "ignore .agent-policy.json via $common/info/exclude"; }
fi
if [ $hooks = 1 ]; then
  if [ -d "$root/.husky" ]; then echo "skip   lefthook install (repo uses husky; port lefthook.yml commands there)"
  elif (cd "$root" && lefthook install); then echo "hooks  lefthook installed"; fi
fi
echo "Edit lefthook.yml and .agent/* to fit this repo, then commit them. Keep .agent-policy.json local (it is git-ignored)."
